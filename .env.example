# 复制为 .env 后填入本机实际值；本文件不含任何真实口令，禁止把真实凭证提交进版本库。
NODE_ENV=development
PORT=3100

# 开发库连接串（角色 hermes_app，仅可连接 hermes_next_dev）
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DEV_DB_NAME>?schema=public"

# 测试库连接串（角色 hermes_test，仅可连接 hermes_next_test，无法连接开发库）
TEST_DATABASE_URL="postgresql://<TEST_DB_USER>:<TEST_DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<TEST_DB_NAME>?schema=public"

# 测试必须使用的数据库角色（tests/test-safety.ts 校验 current_user 与库名后缀）
TEST_DB_ROLE="hermes_test"

# 开发库地址，仅供测试隔离自检使用（验证测试账号无法连接开发库）
DEV_DATABASE_GUARD_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DEV_DB_NAME>?schema=public"

# 会话签名密钥：使用 `openssl rand -hex 32` 生成，禁止使用仓库内的示例值
AUTH_SECRET="<GENERATE_WITH_openssl_rand_hex_32>"

# 仅开发环境允许免密快捷登录；生产环境必须为 false，且 NODE_ENV=production 时一律拒绝
DEV_MOCK_AUTH=false

# 开发种子账号口令（可选；不设置则由 db:seed 随机生成并只在控制台输出一次）
SEED_PASSWORD=""

# ── P3：知识库内容性质开关 ──
# 未配置或 true：知识库/Dashboard 显示「示例数据」性质声明（诚实口径默认）；
# 内容经领域专家审核替换后设为 false，声明消失。
HERMES_KNOWLEDGE_SAMPLE_MODE=true

# ── P4：Advisor 真实 LLM 接入（架构就绪，默认关闭）──
# 必须显式 true 才启用；启用前需先配置 ADVISOR_MODEL_PROVIDER / ADVISOR_MODEL_ID。
ADVISOR_LLM_ENABLED=false
# OpenAI 兼容端点（OpenAI / DeepSeek / Moonshot / 本地 vLLM / Ollama 等），不带末尾斜杠
ADVISOR_LLM_BASE_URL="https://api.openai.com/v1"
# API Key：本地网关可不填（留空则不发送 Authorization 头）
ADVISOR_LLM_API_KEY=""
# 超时与生成参数（示例为默认值，可省略）
ADVISOR_LLM_TIMEOUT_MS=30000
ADVISOR_LLM_MAX_TOKENS=1024
ADVISOR_LLM_TEMPERATURE=0.2
# 运行时模型标识（启用 LLM 前必须配置）
ADVISOR_MODEL_PROVIDER=""
ADVISOR_MODEL_ID=""


# ── PM OS Fusion：操作治理 ──
# 受保护工具操作的 ApprovalGrant HMAC 密钥；至少 32 字符，本地生成，不得提交真实值。
PM_OS_APPROVAL_HMAC_SECRET="<GENERATE_A_RANDOM_32+_CHAR_SECRET>"

# ── Laya System-1 Reflex（可选，默认未配置 = Shadow Unconfigured）──
# 推荐本机启动 Laya HTTP server，Department Assistant 会并行执行 Shadow typed decisions。
# 示例：http://127.0.0.1:8000；未启动 Laya 时保持空值
LAYA_BASE_URL=""
LAYA_API_KEY=""
LAYA_MODEL="typed-decisions"
LAYA_TIMEOUT_MS=1500
# 默认 false；远端 Laya 可能接触业务上下文，未建立数据策略与审计前不要打开。
LAYA_ALLOW_REMOTE=false

# ── Muse Glimmer Resident Assistant（可选，默认 Profile 禁用）──
# Model Control preset: provider=muse-local, modelId=muse-glimmer.
# llama.cpp / vLLM 提供 OpenAI-compatible /v1/chat/completions 即可接入。
# 示例：http://127.0.0.1:8080/v1；未启动本地 OpenAI-compatible 服务时保持空值
MODEL_PROVIDER_MUSE_LOCAL_BASE_URL=""
MODEL_PROVIDER_MUSE_LOCAL_API_KEY=""
MODEL_PROVIDER_MUSE_LOCAL_TIMEOUT_MS=30000
MODEL_PROVIDER_MUSE_LOCAL_MAX_TOKENS=2048
MODEL_PROVIDER_MUSE_LOCAL_TEMPERATURE=0.2
