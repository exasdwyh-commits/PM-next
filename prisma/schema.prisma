generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// 1. Identity & Access Control
// -------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  members  OrganizationMember[]
  projects Project[]
  products Product[]

  // 产品开发工作台与 AI 顾问（蓝图 §7，2026-09-13）
  analysisRuns     AnalysisRun[]
  conversations    Conversation[]
  agentRuns        AgentRun[]
  actionProposals  ActionProposal[]
  knowledgeSources KnowledgeSource[]
  knowledgeDocs    KnowledgeDocument[]
  knowledgeChunks  KnowledgeChunk[]
  knowledgeSyncs   KnowledgeSyncRun[]
  companyFacts     CompanyFact[]
  launchPlans      LaunchPlan[]
  launchMilestones LaunchMilestone[]
  artifacts        Artifact[]

  // Autonomous Workforce Kernel
  workforceAgents      Agent[]
  workforceSkills      Skill[]
  workforceSquads      Squad[]
  workforceAgentTasks  AgentTask[]
  workforceDelegations AgentDelegation[]

  // Evaluation Harness & Experience Loop
  evaluationSuites  EvaluationSuite[]
  evaluationRuns    EvaluationRun[]
  frozenPredictions FrozenPrediction[]
  productOutcomes   ProductOutcome[]
  experienceLessons ExperienceLesson[]

  // Decision Intelligence provenance
  decisionRuns DecisionRun[]

  // Autopilot / Event Wakeup
  autopilots        Autopilot[]
  autopilotReceipts AutopilotEventReceipt[]

  // Transactional business-event outbox
  businessEvents BusinessEvent[]

  // Model Control Center
  modelProfiles       ModelProfileConfig[]
  modelPolicies       ModelPolicyConfig[]
  modelPolicyBindings AgentModelPolicyBinding[]
  modelRuns           ModelRun[]

  // PM OS fusion: operational approvals and reusable knowledge debt
  approvalGrants      ApprovalGrant[]
  knowledgeDebts      KnowledgeDebt[]

  // Channel-specific product development routes
  channelRuleProfiles  ChannelRuleProfileRecord[]
  channelSpecRoutes    ChannelSpecRoute[]
  potentialAssessments PotentialAssessmentRecord[]
}

/**
 * 组织级成员角色（PC-0 Final Security Patch，2026-09-16）
 *
 * 只表达「在公司里的身份」，**不做人事系统**：没有部门、岗位、汇报线、职位等级。
 * 与 `Role`（项目角色：OWNER / DECISION_MAKER / FEEDBACK_PROVIDER / VIEWER）严格分离：
 *   - `OrganizationMember.role` 决定**公司级能力**（知识源配置、公司事实录入/确认）。
 *   - `ProjectMember.role` 决定**产品/项目级能力**（写版本、跑分析、采纳修订、上市）。
 *
 * 为什么必须有这张表：在此之前 `isOrgAdmin` 只能拿「本组织任一项目的 OWNER」当代理，
 * 而任何成员都能创建项目并因此成为 OWNER —— 等于任何人都能自举成「组织管理员」，
 * 进而读知识来源配置（含服务器 rootPath）。权限语义本身有洞，不是页面问题。
 */
enum OrgRole {
  ORG_ADMIN
  MEMBER
}

/**
 * 组织成员关系（最小模型）
 *
 * 不变量：每个 `User` 在所属组织内**应当**有且仅有一条成员记录（`@@unique` 保证）。
 * 未持记录的用户一律按「非管理员」处理，绝不回退到项目角色推断 —— 回退就是自举漏洞的来源。
 */
model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  role           OrgRole  @default(MEMBER)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, role])
  @@index([userId])
}

enum Role {
  OWNER
  DECISION_MAKER
  FEEDBACK_PROVIDER
  VIEWER
  DIGITAL_WORKER
  ORG_ADMIN
}

model User {
  id             String   @id @default(uuid())
  organizationId String
  email          String   @unique
  name           String
  /**
   * scrypt 口令哈希（algo$N$r$p$salt$hash）。仅由管理员脚本/种子写入，不存在公共注册。
   */
  passwordHash   String?
  /// Internal automation identity. System principals have no password/session login.
  isSystem       Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization             Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions                 Session[]
  projectMembers           ProjectMember[]
  /** 组织成员关系（公司级角色）。未经此表授权的用户不得视为组织管理员。 */
  orgMemberships           OrganizationMember[]
  ownedProjects            Project[]               @relation("ProjectOwner")
  decidingProjects         Project[]               @relation("ProjectDecisionMaker")
  feedbackGiven            Feedback[]
  decisionsMade            Decision[]
  auditEvents              AuditEvent[]
  verifiedEvidences        Evidence[]              @relation("EvidenceVerifier")
  authoredSubmissions      WorkSubmission[]        @relation("WorkSubmissionAuthor")
  reviewedSubmissions      WorkSubmission[]        @relation("WorkSubmissionReviewer")
  confirmedApplicabilities ArtifactApplicability[] @relation("ApplicabilityConfirmer")
  researchRunsCreated      ResearchRun[]           @relation("ResearchRunCreator")
  researchTasksCreated     ResearchRunTask[]       @relation("ResearchTaskCreator")

  // 产品开发工作台与 AI 顾问（蓝图 §7，2026-09-13）
  ownedProducts        Product[]        @relation("ProductOwner")
  analysisRunsCreated  AnalysisRun[]    @relation("AnalysisRunCreator")
  conversations        Conversation[]   @relation("ConversationOwner")
  agentRuns            AgentRun[]       @relation("AgentRunUser")
  actionProposalsMade  ActionProposal[] @relation("ActionProposalProposer")
  actionProposalsDecided ActionProposal[] @relation("ActionProposalDecider")
  knowledgeSourcesCreated KnowledgeSource[] @relation("KnowledgeSourceCreator")
  knowledgeSyncsStarted KnowledgeSyncRun[] @relation("KnowledgeSyncStarter")
  companyFactsConfirmed CompanyFact[]  @relation("CompanyFactConfirmer")
  approvalGrantsApproved ApprovalGrant[] @relation("ApprovalGrantApprover")
  launchPlansOwned      LaunchPlan[]    @relation("LaunchPlanOwner")
  launchMilestonesOwned LaunchMilestone[] @relation("LaunchMilestoneOwner")

  // Autonomous Workforce Kernel
  workforceAgentsOwned        Agent[]           @relation("WorkforceAgentOwner")
  workforceSkillsCreated      Skill[]           @relation("WorkforceSkillCreator")
  workforceSkillAssignments   AgentSkill[]      @relation("WorkforceSkillAssigner")
  workforceSquadsCreated      Squad[]           @relation("WorkforceSquadCreator")
  workforceSquadMemberships   SquadMember[]     @relation("WorkforceSquadHumanMember")
  workforceAgentTasksCreated  AgentTask[]       @relation("WorkforceAgentTaskCreator")
  workforceDelegationsCreated AgentDelegation[] @relation("WorkforceDelegationCreator")

  // Evaluation Harness & Experience Loop
  evaluationSuitesCreated   EvaluationSuite[]   @relation("EvaluationSuiteCreator")
  evaluationRunsStarted     EvaluationRun[]     @relation("EvaluationRunStarter")
  frozenPredictionsCreated  FrozenPrediction[]  @relation("FrozenPredictionCreator")
  productOutcomesVerified   ProductOutcome[]    @relation("ProductOutcomeVerifier")
  experienceLessonsReviewed ExperienceLesson[] @relation("ExperienceLessonReviewer")

  // Decision Intelligence provenance
  decisionRunsCreated DecisionRun[] @relation("DecisionRunCreator")

  // Autopilot / Event Wakeup
  autopilotsCreated Autopilot[] @relation("AutopilotCreator")

  // Transactional business-event outbox
  businessEventsCreated BusinessEvent[] @relation("BusinessEventCreator")

  @@index([organizationId, isSystem])
  @@index([organizationId])
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
}

// -------------------------------------------------------------
// 2. Projects
// -------------------------------------------------------------

enum ProjectMode {
  NEW_PRODUCT
  FIXED_PRODUCT
}

enum ProjectStage {
  DRAFT
  RESEARCH
  SAMPLING
  PRODUCTION_PREP
  PRODUCTION
  DELIVERED
}

model Project {
  id               String       @id @default(uuid())
  organizationId   String
  mode             ProjectMode  @default(NEW_PRODUCT)
  title            String
  target           String
  constraints      String?
  stage            ProjectStage @default(DRAFT)
  revision         Int          @default(1)
  isDemo           Boolean      @default(false)
  productVersionId String?
  /// 显式产品关联（蓝图 §4.1）：允许为空以保留既有「无产品的探索项目」；
  /// 从产品入库时由 createDevelopmentProduct 在同一事务内写入。
  productId        String?
  ownerId          String
  decisionMakerId  String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  decisionMaker  User?           @relation("ProjectDecisionMaker", fields: [decisionMakerId], references: [id])
  productVersion ProductVersion? @relation("ProjectProductVersion", fields: [productVersionId], references: [id])
  product        Product?        @relation("ProjectProduct", fields: [productId], references: [id])

  members         ProjectMember[]
  workItems       WorkItem[]
  evidences       Evidence[]
  dataGaps        DataGap[]
  feedbackItems   Feedback[]
  decisionPackets DecisionPacket[]
  researchRuns    ResearchRun[]
  launchPlans     LaunchPlan[]
  knowledgeDebts  KnowledgeDebt[]

  @@index([organizationId])
  @@index([ownerId])
  @@index([decisionMakerId])
  @@index([productVersionId])
  @@index([productId])
}

// -------------------------------------------------------------
// 3. Products & Product Versions
// -------------------------------------------------------------

model Product {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  /// 编码唯一性收敛到**组织内**（D-001 / I-005 修复）：
  /// 全局唯一会让别的组织无法使用已占用的编码，并把「该码被占」确定性地告诉它
  /// （跨组织存在性 oracle）。同组织同码仍由 409 拦下（P2002 中央映射，D-015）。
  identityCode   String
  targetAudience String
  marketPath     String
  devMode        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  /// 治理写入修订号：所有产品方案变更必须通过数据库级 CAS 条件递增。
  /// 与 ProductVersion 不同：这是并发控制令牌，不是面向用户的版本号。
  methodRevision Int      @default(0)

  // ---- 产品开发工作台入库字段（蓝图 §4.2，均为可空：先兼容为空，按真实关系回填后再收紧） ----
  /// 一句话想法 / 核心概念。入库首屏必填项之一。
  coreIdea         String?
  /// 核心卖点（首屏必填）
  coreSellingPoints String?
  /// 预期渠道（首屏必填）
  targetChannels   String?
  /// 产品负责人（默认入库人）
  ownerId          String?
  /// 产品生命周期：与 ProjectStage 不是一对一（蓝图 §4.5）
  lifecycleStage   ProductLifecycleStage @default(IDEA)
  /// 目标上市日（未定即 null，UI 显示「未设置」）
  targetLaunchDate DateTime?
  /// 实际上市日：由实际上市动作/证据确认，不因审批通过自动写入（蓝图 §4.5）
  actualLaunchDate DateTime?
  /// 价格预期（选填）
  priceExpectation String?
  /// 剂型 / 规格（选填）
  formSpec         String?
  /// 禁用项（选填）
  forbiddenItems   String?
  /// 入库来源：MANUAL 手工填写 / AI_EXTRACTED 粘贴文本提取草稿（用户已编辑确认）
  sourceKind       String   @default("MANUAL")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?            @relation("ProductOwner", fields: [ownerId], references: [id])
  versions     ProductVersion[]
  projects     Project[]        @relation("ProjectProduct")
  analysisRuns AnalysisRun[]
  conversations Conversation[]
  actionProposals ActionProposal[]
  launchPlans  LaunchPlan[]
  frozenPredictions FrozenPrediction[]

  @@unique([organizationId, identityCode])
  @@index([organizationId])
  @@index([organizationId, methodRevision])
  @@index([ownerId])
  @@index([lifecycleStage])
}

/// 产品生命周期（面向用户的口径，蓝图 §4.5）
/// 想法入库 → 分析优化 → 打样验证 → 上市准备 → 已上市 → 复盘 / 暂停
enum ProductLifecycleStage {
  IDEA
  ANALYSIS
  SAMPLING
  LAUNCH_PREP
  LAUNCHED
  REVIEW
  PAUSED
}

model ProductVersion {
  id              String   @id @default(uuid())
  productId       String
  versionTag      String
  specs           Json
  technicalAdvice String?
  experienceGoals String?
  targetCost      Decimal? @db.Decimal(12, 2)
  currency        String   @default("CNY")
  unknowns        Json?
  evidenceRefs    Json?
  isImmutable     Boolean  @default(true)
  isConfirmed     Boolean  @default(false)
  createdAt       DateTime @default(now())

  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  projects        Project[]        @relation("ProjectProductVersion")
  decisionPackets DecisionPacket[]
  analysisRuns    AnalysisRun[]
  artifacts       Artifact[]
  frozenPredictions FrozenPrediction[]
  channelSpecRoutes ChannelSpecRoute[]
  potentialAssessments PotentialAssessmentRecord[]

  @@unique([productId, versionTag])
  @@index([productId])
}

// =============================================================
// 3.5 Channel Route & Product Potential Persistence
//     Same ProductVersion may have multiple channel-specific routes.
//     Rules and assessments are versioned snapshots; unknowns remain explicit.
// =============================================================

enum ChannelRuleRecordStatus {
  ASSUMED
  CONFIRMED
  SUPERSEDED
}

enum ChannelSpecRouteStatus {
  DRAFT
  BLOCKED
  VALIDATION_READY
  VALIDATING
  CONFIRMED
  REJECTED
  SUPERSEDED
}

enum ProductPotentialVerdict {
  BLOCKED
  NEEDS_EVIDENCE
  DEPRIORITIZE
  VALIDATE
  PRIORITIZE_FOR_VALIDATION
}

enum PotentialConfidenceBand {
  LOW
  MEDIUM
  HIGH
}

model ChannelRuleProfileRecord {
  id                           String                  @id @default(uuid())
  organizationId               String
  channelKey                   String
  label                        String
  version                      String
  status                       ChannelRuleRecordStatus @default(ASSUMED)
  sourceRefs                   Json
  minRetailPrice               Decimal?                @db.Decimal(12, 2)
  maxRetailPrice               Decimal?                @db.Decimal(12, 2)
  minBundleQuantity            Int?
  maxBundleQuantity            Int?
  allowedUnitLabels            Json?
  commissionRate               Decimal                 @db.Decimal(7, 3)
  platformFeeRate              Decimal                 @db.Decimal(7, 3)
  marketingRate               Decimal                 @db.Decimal(7, 3)
  managementFeeRate            Decimal                 @db.Decimal(7, 3)
  returnRate                   Decimal                 @db.Decimal(7, 3)
  returnHandlingFeeRate        Decimal                 @db.Decimal(7, 3)
  targetContributionMarginRate Decimal                 @db.Decimal(7, 3)
  constraints                  Json?
  effectiveFrom                DateTime?
  effectiveUntil               DateTime?
  supersedesId                 String?
  createdById                  String
  confirmedById                String?
  confirmedAt                  DateTime?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  routes       ChannelSpecRoute[]
  supersedes   ChannelRuleProfileRecord? @relation("ChannelRuleSupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy ChannelRuleProfileRecord[] @relation("ChannelRuleSupersedes")

  @@unique([organizationId, channelKey, version])
  @@index([organizationId, channelKey, status])
  @@index([supersedesId])
}

model ChannelSpecRoute {
  id                            String                 @id @default(uuid())
  organizationId                String
  productVersionId              String
  channelRuleProfileId          String
  routeKey                      String
  revision                      Int                    @default(1)
  name                          String
  status                        ChannelSpecRouteStatus @default(DRAFT)
  retailPrice                   Decimal                @db.Decimal(12, 2)
  bundleQuantity                Int
  unitLabel                     String
  packageSpec                   String?
  productCostPerUnit            Decimal                @db.Decimal(12, 2)
  packagingCostPerOrder         Decimal                @db.Decimal(12, 2)
  freightCostPerOrder           Decimal                @db.Decimal(12, 2)
  currency                      String                 @default("CNY")
  ruleStatusSnapshot            ChannelRuleRecordStatus
  ruleVersionSnapshot           String
  evaluationSnapshot            Json
  feasible                      Boolean
  blockerCount                  Int                    @default(0)
  contributionMarginRate        Decimal                @db.Decimal(9, 3)
  requiredMaxProductCostPerUnit Decimal?               @db.Decimal(12, 2)
  supersedesId                  String?
  createdById                   String
  createdAt                     DateTime               @default(now())

  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productVersion     ProductVersion           @relation(fields: [productVersionId], references: [id], onDelete: Cascade)
  channelRuleProfile ChannelRuleProfileRecord @relation(fields: [channelRuleProfileId], references: [id])
  assessments        PotentialAssessmentRecord[]
  supersedes         ChannelSpecRoute?        @relation("ChannelRouteSupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy       ChannelSpecRoute[]        @relation("ChannelRouteSupersedes")

  @@unique([productVersionId, routeKey, revision])
  @@index([organizationId, createdAt])
  @@index([productVersionId, status])
  @@index([channelRuleProfileId])
  @@index([supersedesId])
}

model PotentialAssessmentRecord {
  id                    String                   @id @default(uuid())
  organizationId        String
  productVersionId      String
  channelRouteId        String?
  ruleVersion           String
  dimensionSnapshot     Json
  gateSnapshot          Json
  evidenceFingerprint   String
  marketValidationVerified Boolean               @default(false)
  verdict               ProductPotentialVerdict
  diagnosticIndex       Decimal?                 @db.Decimal(7, 2)
  coverageRatio         Decimal                  @db.Decimal(7, 4)
  verifiedCoverageRatio Decimal                  @db.Decimal(7, 4)
  confidenceBand        PotentialConfidenceBand
  reasons               Json
  blockers              Json
  unknownGates          Json
  supersedesId          String?
  createdById           String
  createdAt             DateTime                 @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productVersion ProductVersion @relation(fields: [productVersionId], references: [id], onDelete: Cascade)
  channelRoute   ChannelSpecRoute? @relation(fields: [channelRouteId], references: [id], onDelete: SetNull)
  supersedes     PotentialAssessmentRecord? @relation("PotentialAssessmentSupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy   PotentialAssessmentRecord[] @relation("PotentialAssessmentSupersedes")

  @@index([organizationId, createdAt])
  @@index([productVersionId, createdAt])
  @@index([channelRouteId, createdAt])
  @@index([supersedesId])
}

// -------------------------------------------------------------
// 4. Work Items, Runs, Submissions & Artifacts
// -------------------------------------------------------------

enum WorkExecutorType {
  HUMAN
  TEST_AGENT
  DIGITAL_WORKER
}

enum WorkItemStatus {
  TODO
  RUNNING
  SUBMITTED
  CHANGES_REQUESTED
  ACCEPTED
}

model WorkItem {
  id                  String           @id @default(uuid())
  projectId           String
  title               String
  target              String
  executorType        WorkExecutorType @default(HUMAN)
  dependencies        Json?
  inputRevision       Int              @default(1)
  status              WorkItemStatus   @default(TODO)
  deliverableReq      String
  currentSubmissionId String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  project         Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  receipts        RunReceipt[]
  submissions     WorkSubmission[]
  artifacts       Artifact[]
  applicabilities ArtifactApplicability[]
  agentTasks      AgentTask[]

  @@index([projectId])
  @@index([status])
}

enum RunReceiptStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum RunMode {
  MANUAL
  TEST_STUB
  AUTOMATED
  /// P4: 真实 LLM 生成回复（advisor.llm.enabled=true 时使用）
  LLM
}

model RunReceipt {
  id            String           @id @default(uuid())
  workItemId    String
  attempt       Int              @default(1)
  inputRevision Int
  runMode       RunMode          @default(MANUAL)
  status        RunReceiptStatus @default(PENDING)
  startedAt     DateTime         @default(now())
  endedAt       DateTime?
  errorMessage  String?
  artifactIds   Json?
  createdAt     DateTime         @default(now())

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@index([workItemId])
}

model WorkSubmission {
  id            String               @id @default(uuid())
  workItemId    String
  attempt       Int                  @default(1)
  inputRevision Int
  submittedById String
  runMode       RunMode              @default(MANUAL)
  status        ArtifactReviewStatus @default(PENDING)
  reviewReason  String?
  reviewedAt    DateTime?
  reviewedById  String?
  createdAt     DateTime             @default(now())

  workItem        WorkItem                @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  submittedBy     User                    @relation("WorkSubmissionAuthor", fields: [submittedById], references: [id])
  reviewedBy      User?                   @relation("WorkSubmissionReviewer", fields: [reviewedById], references: [id])
  artifacts       Artifact[]
  applicabilities ArtifactApplicability[]

  @@index([workItemId])
}

enum ProducerType {
  MANUAL
  TEST_STUB
  AI
}

enum ArtifactReviewStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/**
 * 沿用成果的适用性确认状态：待负责人确认 / 已确认适用于当前基线 / 已否决
 */
enum ArtifactApplicabilityStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model Artifact {
  id             String               @id @default(uuid())
  workItemId     String?
  submissionId   String?
  /**
   * 组织归属（契约 I-001，2026-09-16 批准实施）：成果是公司资产，审计与跨项目查询
   * 必须能直接按组织过滤，而不是每次沿 workItem → project 绕行。
   * 允许为空仅为兼容历史行；**写入路径必须显式赋值**。
   */
  organizationId String?
  /**
   * 绑定的产品版本（契约 I-002）：营销文案 / 报价 / 样品必须知道自己属于哪个
   * `ProductVersion`，否则「产品已 V3，系统仍拿 V1 文案继续用」无法判定。
   * ProductVersion 是本系统的版本真相源，成果不绑定版本即与版本治理原则冲突。
   */
  productVersionId String?
  /**
   * 结构化内容的 schema 版本（契约 I-003），与 `content` JSON 顶层 `schemaVersion` 同源。
   * 只在 JSON 内则不可查询，无法按版本批量处理历史数据。
   */
  schemaVersion  String?
  type           String
  title          String
  content        String
  contentVersion Int                  @default(1)
  producerType   ProducerType         @default(MANUAL)
  inputRevision  Int                  @default(1)
  evidenceRefs   Json?
  reviewStatus   ArtifactReviewStatus @default(PENDING)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization    Organization?           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productVersion  ProductVersion?         @relation(fields: [productVersionId], references: [id], onDelete: SetNull)
  workItem        WorkItem?               @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  submission      WorkSubmission?         @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  applicabilities ArtifactApplicability[]

  @@index([organizationId])
  @@index([productVersionId])
  @@index([organizationId, type])
  @@index([workItemId])
  @@index([submissionId])
}

/**
 * 沿用成果适用性确认记录 (C01 局部修订)
 * 局部修订时，未发生变化的成果不应被强制重新生成（那会伪装成「重新研究」），
 * 但也不能默认沿用——必须留下一条记录，说明该成果是哪个基线产出的、
 * 由谁确认它适用于哪个新基线。原始 Artifact.inputRevision 保持历史事实不变。
 */
model ArtifactApplicability {
  id                  String                      @id @default(uuid())
  artifactId          String
  submissionId        String
  workItemId          String
  /**
   * 该成果被确认适用的输入基线（决策包的 inputBaselineRevision）
   */
  baselineRevision    Int
  /**
   * 该成果实际产出时的输入基线（历史事实，不被覆盖）
   */
  sourceInputRevision Int
  /**
   * 确认时刻的成果内容指纹：内容若再变化，原确认即失效
   */
  contentHash         String
  status              ArtifactApplicabilityStatus @default(PENDING)
  note                String?
  confirmedById       String?
  confirmedAt         DateTime?
  createdAt           DateTime                    @default(now())

  artifact    Artifact       @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  submission  WorkSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  workItem    WorkItem       @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  confirmedBy User?          @relation("ApplicabilityConfirmer", fields: [confirmedById], references: [id])

  @@unique([artifactId, submissionId])
  @@index([artifactId, baselineRevision])
  @@index([workItemId])
  @@index([submissionId])
}

// -------------------------------------------------------------
// 5. Evidence & Collaboration
// -------------------------------------------------------------

enum EvidenceNature {
  REAL
  DEMO
}

enum EvidenceVerifyStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

/**
 * P1-02 市场验证状态：UNAPPLIED 未取得 / IN_PROGRESS 采集核验中 / VERIFIED_BY_LEAD 负责人确认已验证
 */
enum ValidationStatus {
  UNAPPLIED
  IN_PROGRESS
  VERIFIED_BY_LEAD
}

model Evidence {
  id                    String               @id @default(uuid())
  projectId             String
  contentOrUri          String
  source                String
  author                String?
  obtainedAt            DateTime             @default(now())
  infoDate              DateTime?
  hash                  String
  nature                EvidenceNature       @default(REAL)
  verifyStatus          EvidenceVerifyStatus @default(UNVERIFIED)
  verifiedByUserId      String?
  verifiedAt            DateTime?
  fileKey               String?
  fileSize              Int?
  mimeType              String?
  originalFilename      String?
  /**
   * 适用产品：该资料针对的竞品/产品；渠道：来源或适用渠道（如抖音/快手/私域）
   */
  productRef            String?
  channel               String?
  /**
   * P1-02 市场验证：真实渠道反馈/带时间范围的销售资料/明确记录的用户反馈，记录样本规模、时间范围与局限
   */
  validationSampleSize  String?
  validationTimeRange   String?
  validationLimitations String?
  /**
   * 市场验证状态：仅负责人(OWNER)可手动置 VERIFIED_BY_LEAD；模型/纯函数一律不得写入，避免以模型评分冒充真实验证
   */
  validationStatus      ValidationStatus     @default(UNAPPLIED)
  /// PM OS fusion: source/provenance metadata. Nullable for historical rows.
  sourceType            String?
  trustTier             String?
  dataClass             String               @default("INTERNAL")
  untrustedInput        Boolean              @default(false)
  fetchedAt             DateTime?
  sourceOrganization    String?
  injectionStatus       String?
  createdAt             DateTime             @default(now())

  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  verifiedBy   User?           @relation("EvidenceVerifier", fields: [verifiedByUserId], references: [id])
  claims         EvidenceClaim[]
  sourceCaptures EvidenceSourceCapture[]
  resolvingGap   DataGap[]       @relation("GapResolvedByEvidence")

  @@index([projectId])
  @@index([nature])
  @@index([verifiedByUserId])
}

/**
 * 证据细分断言（P1-01 统一证据结构核心层，C02/R2-03）
 * 一条证据（原文/附件）可拆解为多个「支撑的具体字段断言」，每一项必须明确：
 * - kind：FACT（原文直接支撑的事实）、INFERENCE（基于证据的推断）、ASSUMPTION（未确认假设）；
 * - fieldKey：支撑的具体字段（如 price、salesVolume、netWeight、dosageForm、targetAudience）；
 * - 价格必须带规格(spec)、计价单位(unit)、机制(mechanism，如到手价/划线价/组合装价)，严禁单盒价与组合装价混算。
 * - conflictGroup + selectionReason：冲突资料并列展示并记录选用理由，不静默覆盖。
 */
enum EvidenceClaimKind {
  FACT
  INFERENCE
  ASSUMPTION
}

model EvidenceClaim {
  id                String            @id @default(uuid())
  evidenceId        String
  fieldKey          String
  fieldName         String
  kind              EvidenceClaimKind
  value             String
  currency          String            @default("CNY")
  spec              String? // 规格，如「30条/盒」「6盒/组」
  unit              String? // 计价单位，如「盒」「条」「组」
  mechanism         String? // 计价机制，如「到手价」「划线价」「组合装价」
  applicableProduct String?
  applicableChannel String?
  conflictGroup     String? // 命中冲突并列时归入同一组
  selectionReason   String? // 冲突时选用理由
  /// Claim support is independent from Evidence.verifyStatus.
  evidenceLevel     String            @default("UNKNOWN")
  freshness         String            @default("UNKNOWN")
  verifierRunId     String?
  createdAt         DateTime          @default(now())

  evidence      Evidence               @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  verifications EvidenceVerification[]

  @@index([evidenceId])
  @@index([fieldKey])
}

/**
 * 数据缺口（P1-01）：采集/验证失败时显式记录缺口，不自动补成事实，经补充证据后可流转 FILLED
 */
enum DataGapStatus {
  OPEN
  FILLED
}

model DataGap {
  id                   String        @id @default(uuid())
  projectId            String
  fieldKey             String
  fieldName            String
  description          String
  status               DataGapStatus @default(OPEN)
  resolvedByEvidenceId String?
  resolvedAt           DateTime?
  createdAt            DateTime      @default(now())

  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  resolvedByEvidence Evidence? @relation("GapResolvedByEvidence", fields: [resolvedByEvidenceId], references: [id])

  @@unique([projectId, fieldKey])
  @@index([projectId])
  @@index([fieldKey])
  @@index([status])
}

enum FeedbackStatus {
  OPEN
  ACCEPTED
  REJECTED
  NEEDS_INFO
}

model Feedback {
  id                 String         @id @default(uuid())
  projectId          String
  targetType         String
  targetId           String
  targetVersion      String?
  authorId           String
  content            String
  status             FeedbackStatus @default(OPEN)
  dispositionReason  String?
  revisionWorkItemId String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([projectId])
  @@index([authorId])
}



/// Independent claim-to-source verification record. A source being genuine does
/// not imply that it supports a particular claim.
model EvidenceSourceCapture {
  id                 String   @id @default(uuid())
  evidenceId         String
  sourceUri          String
  sourceType         String
  trustTier          String
  sourceOrganization String?
  httpStatus         Int
  contentHash        String
  rawContentPreview  String
  injectionStatus    String
  injectionFlags     Json?
  fetchedAt          DateTime
  fetcherIdentity    String
  remoteAddress      String?
  contentType        String?
  redirectCount      Int      @default(0)
  createdAt          DateTime @default(now())

  evidence      Evidence               @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  verifications EvidenceVerification[]

  @@index([evidenceId, fetchedAt])
  @@index([sourceOrganization])
  @@index([trustTier])
}

model EvidenceVerification {
  id                 String   @id @default(uuid())
  evidenceClaimId    String
  sourceCaptureId    String?
  verifierIdentity   String
  supportStatus      String
  supportSpan        String?
  sourceUri          String?
  sourceOrganization String?
  checkedAt          DateTime @default(now())
  metadata           Json?

  evidenceClaim EvidenceClaim          @relation(fields: [evidenceClaimId], references: [id], onDelete: Cascade)
  sourceCapture EvidenceSourceCapture? @relation(fields: [sourceCaptureId], references: [id], onDelete: SetNull)

  @@index([evidenceClaimId, checkedAt])
  @@index([sourceCaptureId])
  @@index([supportStatus])
}

/// Operational permission grant. This complements, but never replaces,
/// DecisionPacket/G1/G2/G3 business authorization.
model ApprovalGrant {
  id             String   @id @default(uuid())
  organizationId String
  approvedById   String
  taskRef        String
  capability     String
  resource       String
  actionHash     String
  issuer         String
  channel        String?
  signature      String
  singleUse      Boolean  @default(true)
  issuedAt       DateTime @default(now())
  validUntil     DateTime
  usedAt         DateTime?
  usedByRunId    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvedBy   User         @relation("ApprovalGrantApprover", fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([organizationId, validUntil])
  @@index([approvedById])
  @@index([taskRef, capability])
}

/// Reusable organization-level knowledge deficiency. Project-specific structured
/// missing fields remain DataGap and are not duplicated here.
model KnowledgeDebt {
  id                   String   @id @default(uuid())
  organizationId       String
  projectId            String?
  normalizedKey        String
  topic                String
  reason               String
  importance           String   @default("MEDIUM")
  occurrences          Int      @default(1)
  status               String   @default("OPEN")
  suggestedExpertClass String?
  resolvedByEvidenceId String?
  relatedDataGapId     String?
  createdAt            DateTime @default(now())
  lastSeenAt           DateTime @default(now())
  resolvedAt           DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([organizationId, normalizedKey])
  @@index([organizationId, status])
  @@index([projectId])
  @@index([lastSeenAt])
}

// -------------------------------------------------------------
// 6. Decision Packets & Gate Decisions
// -------------------------------------------------------------

enum GateType {
  RESEARCH_SAMPLING_GATE
  PRODUCTION_GATE
  LAUNCH_GATE
}

enum DecisionPacketStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  CHANGES_REQUESTED
  DEFERRED
  REJECTED
  WITHDRAWN
}

model DecisionPacket {
  id               String               @id @default(uuid())
  gate             GateType             @default(RESEARCH_SAMPLING_GATE)
  projectId        String
  productVersionId String?
  launchPlanId     String?
  launchPlanHash   String?
  artifactVersions Json
  evidenceVersions Json
  budgetAmount     Decimal?             @db.Decimal(12, 2)
  budgetCurrency   String               @default("CNY")
  budgetScope      String?
  validationPlan   String
  requiredChecks   Json
  scopeHash        String
  status           DecisionPacketStatus @default(DRAFT)
  snapshot         Json?
  submittedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productVersion ProductVersion? @relation(fields: [productVersionId], references: [id])
  launchPlan     LaunchPlan?     @relation("LaunchDecisionPackets", fields: [launchPlanId], references: [id], onDelete: SetNull)
  formalG3ForPlan LaunchPlan?    @relation("LaunchFormalG3")
  decisions      Decision[]

  @@index([projectId])
  @@index([launchPlanId])
  @@index([status])
}

enum DecisionOutcome {
  APPROVE
  REQUEST_CHANGES
  DEFER
  REJECT
  WITHDRAW
}

model Decision {
  id          String          @id @default(uuid())
  packetId    String
  actorId     String
  decision    DecisionOutcome
  reason      String
  obligations String?
  decidedAt   DateTime        @default(now())

  packet DecisionPacket @relation(fields: [packetId], references: [id], onDelete: Cascade)
  actor  User           @relation(fields: [actorId], references: [id])

  @@index([packetId])
  @@index([actorId])
}

// -------------------------------------------------------------
// 7. Audit & Idempotency Infrastructure
// -------------------------------------------------------------

model AuditEvent {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  objectType String
  objectId   String
  revision   Int?
  requestId  String?
  summary    String
  details    Json?
  timestamp  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([objectType, objectId])
  @@index([timestamp])
}

model IdempotencyRecord {
  id             String   @id @default(uuid())
  key            String   @unique
  actorId        String
  commandScope   String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())

  @@index([key])
  @@index([actorId, commandScope])
}

// -------------------------------------------------------------
// R: Research Run (五阶段研究编排 · 迁移自老版 research-run.ts 机制)
//   报告阶段复用本模块的规则合成 synthesizeMarketResearch，不引入 LLM。
// -------------------------------------------------------------

enum ResearchRunStatus {
  RUNNING
  PUBLISHED
  FAILED
}

enum ResearchRunTaskStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ResearchTaskType {
  CLARIFY_SCOPE
  BRANCH_MARKET
  BRANCH_PRODUCT
  BRANCH_CAPABILITY
  OTHER
}

model ResearchRun {
  id                  String            @id @default(uuid())
  projectId           String
  question            String
  inputRevision       Int
  scopeSnapshotJson   Json
  status              ResearchRunStatus @default(RUNNING)
  createdById         String
  publishedSnapshotId String?
  errorReason         String?
  publishedAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  project              Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy            User                  @relation("ResearchRunCreator", fields: [createdById], references: [id])
  tasks                ResearchRunTask[]
  researchRunSnapshots ResearchRunSnapshot[]

  @@index([projectId])
  @@index([status])
}

model ResearchRunTask {
  id           String                @id @default(uuid())
  runId        String
  projectId    String
  taskType     ResearchTaskType
  title        String
  status       ResearchRunTaskStatus @default(QUEUED)
  attempt      Int                   @default(0)
  inputJson    Json
  resultJson   Json?
  errorReason  String?
  runnerPid    Int?
  runnerBootId String?
  parentTaskId String?
  seq          Int?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime              @default(now())

  run         ResearchRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  parentTask  ResearchRunTask?  @relation("ResearchSubTask", fields: [parentTaskId], references: [id])
  subtasks    ResearchRunTask[] @relation("ResearchSubTask")
  createdBy   User?             @relation("ResearchTaskCreator", fields: [createdById], references: [id])
  createdById String?

  @@index([runId])
  @@index([status])
}

model ResearchRunSnapshot {
  id              String   @id @default(uuid())
  runId           String
  reportVersion   Int
  reportJson      Json
  publishedStatus String   @default("published")
  generatedAt     DateTime @default(now())

  run ResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, reportVersion])
  @@index([runId])
}

// S: Signal Radar（信号采集 · 机制迁移自老版 signal-*.ts 骨架）
//   SignalSource：全局信号源注册表与健康状态（跨项目，不绑定具体 Project）
//   SignalItem：采集/录入的信号，字段对齐新版 Evidence 包装（nature/verifyStatus/productRef/channel/hash），
//   既保留老版雷达分级（valueTier/valueReason），也支持后续「信号→证据」封装转换（evidenceId 溯源）。
//   蝉妈妈等外部平台 adapter 在本模块仅标验证项（mode=manual / verifyStatus 不自动置 VERIFIED），绝不虚构数据。
// -------------------------------------------------------------

model SignalSource {
  id            String    @id @default(uuid())
  /// 组织归属（蓝图 §7）：NULL = 公共来源配置（所有组织可见，例如公开平台适配器）；
  /// 非空 = 该组织的私有来源配置。写入时必须显式区分，禁止把私有来源当公共配置。
  organizationId String?
  key           String    @unique
  name          String
  category      String    @default("trend")
  description   String?
  enabled       Boolean   @default(true)
  priority      String    @default("P1")
  /// auto（有自动收集器）/ manual（仅人工录入；无收集器则采集时跳过，不虚构）
  mode          String    @default("auto")
  lastStatus    String?   @default("idle")
  lastError     String?
  lastCollected DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items SignalItem[]

  @@index([enabled, priority])
  @@index([organizationId])
}

model SignalItem {
  id           String               @id @default(uuid())
  /// 组织归属（蓝图 §7）：信号是公司私有内容，接入公司机会库前必须带上组织。
  /// 2026-09-16 收紧为 NOT NULL：去重唯一键必须包含组织，否则跨组织同标题会互相顶掉，
  /// 并把「另一家公司已录入过这个信号」这一事实泄露给调用方（D-002）。
  /// 若本列为 NULL，唯一约束在 PostgreSQL 下按 NULLS DISTINCT 处理，可被重复插入绕过。
  organizationId String
  sourceKey    String
  sourceName   String
  category     String               @default("trend")
  title        String
  summary      String?
  relevance    String?
  url          String?
  /// 对齐新版 Evidence 包装：数据性质（REAL 真实资料 / DEMO）与核验状态（UNVERIFIED 默认，绝不自动 VERIFIED）
  nature       EvidenceNature       @default(REAL)
  verifyStatus EvidenceVerifyStatus @default(UNVERIFIED)
  /// 适用产品（竞品/产品）与渠道（抖音/快手/私域…）
  productRef   String?
  channel      String?
  /// 去重指纹：同源同 hash 视为同一信号，采集时跳过重复
  hash         String?
  /// 信号封装为证据时记录落点，溯源「信号→证据」链路
  evidenceId   String?
  rawJson      String?
  importance   Int                  @default(1)
  /// 价值分级：high / normal / low（NULL = 未评估）
  valueTier    String?
  valueReason  String?
  collectedBy  String               @default("manual")
  collectedAt  DateTime             @default(now())
  createdAt    DateTime             @default(now())

  source SignalSource? @relation(fields: [sourceKey], references: [key])

  @@index([sourceKey])
  @@index([category])
  @@index([valueTier])
  @@index([organizationId])
  /// 去重指纹按**组织**隔离（原为 @@unique([sourceKey, hash]) 全局唯一）：
  /// 组织 A 与组织 B 各自录入同标题信号都必须能成功，且互不知情。
  @@unique([organizationId, sourceKey, hash])
}

// =============================================================
// T. 产品开发：分析运行、评分（蓝图 §4.4）
//    原则：AnalysisRun 固定产品版本 / 证据版本 / 公司上下文版本 / 评分规则版本 / 模型；
//    历史结果不可被最新结果覆盖；未知项不补造数值（score 保持 null）。
// =============================================================

enum AnalysisRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum AnalysisRunKind {
  /// 首轮基线分析（v1）
  BASELINE
  /// 采纳修改草案后的重评（v2+）
  REVISION_REVIEW
}

enum AnalysisDimensionKey {
  DEMAND_VALUE
  DIFFERENTIATION
  UNIT_ECONOMICS
  COMPANY_FIT
  DELIVERY_FEASIBILITY
  LAUNCH_READINESS
}

model AnalysisRun {
  id               String           @id @default(uuid())
  organizationId   String
  productId        String
  productVersionId String
  kind             AnalysisRunKind   @default(BASELINE)
  status           AnalysisRunStatus @default(RUNNING)
  /// 输入快照：证据 id+hash 集合、公司上下文版本、评分规则版本、统计时间
  inputSnapshot    Json
  /// 证据版本指纹（用于判断旧利润结论是否仍适用）
  evidenceFingerprint String?
  /// 评分规则版本（蓝图 §4.4：保存评分规则版本，允许以后调整）
  ruleVersion      String            @default("v1")
  provider         String?
  modelId          String?
  runMode          RunMode           @default(MANUAL)
  /// 上一轮基线：本轮为 REVISION_REVIEW 时指向被改动的 v1
  supersedesRunId  String?
  errorReason      String?
  createdById      String
  startedAt        DateTime          @default(now())
  finishedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVersion ProductVersion     @relation(fields: [productVersionId], references: [id])
  createdBy      User               @relation("AnalysisRunCreator", fields: [createdById], references: [id])
  dimensions     AnalysisDimension[]
  scorecard      Scorecard?

  @@index([organizationId])
  @@index([productId])
  @@index([productVersionId])
  @@index([status])
}

model AnalysisDimension {
  id         String               @id @default(uuid())
  runId      String
  dimension  AnalysisDimensionKey
  /// 未知项保持 null，不默认 0、不补造数值
  score      Int?
  /// 依据（必须有来源或明确标注为判断）
  basis      String?
  /// 假设（未确认的推断，与依据分离）
  assumptions String?
  /// 缺口
  gaps       String?
  /// 建议
  recommendation String?
  /// 人工调整理由
  humanAdjustReason String?
  /// 证据引用：[{ evidenceId, hash, claimId, fieldKey }]
  evidenceRefs Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  run AnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, dimension])
  @@index([runId])
}

/// 评分卡：按已评维度权重归一化的结果；覆盖不足时 provisional = true（暂评），
/// 且不得进入可直接排序的完整评分榜（蓝图 §4.4）。
model Scorecard {
  id               String   @id @default(uuid())
  runId            String   @unique
  productId        String
  productVersionId String
  /// 权重配置与版本：{ "DEMAND_VALUE": 25, ... }
  weights          Json
  ruleVersion      String   @default("v1")
  /// 已评维度覆盖率（已评维度权重 / 全部权重）
  coverageRatio    Float    @default(0)
  /// 暂评（覆盖率不足）
  provisional      Boolean  @default(true)
  /// 按已评维度权重归一化后的分数；无任何已评维度时为 null
  weightedScore    Float?
  computedAt       DateTime @default(now())

  run AnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// =============================================================
// U. AI 顾问：会话、运行、工具调用、可执行提议（蓝图 §5、§6）
//    写入链：提议 → 权限与版本检查 → 用户确认 → 业务命令 → 回执。
//    模型不直接写数据库。
// =============================================================

enum ConversationKind {
  ADVISOR
  PRODUCT
}

model Conversation {
  id             String           @id @default(uuid())
  organizationId String
  ownerId        String
  kind           ConversationKind @default(ADVISOR)
  title          String
  /// 产品页内顾问会话绑定产品；全局顾问为 null
  productId      String?
  /// Conversation-level model/advisor/skill/capability preferences for Kern.
  runtimeConfig  Json?
  archivedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User             @relation("ConversationOwner", fields: [ownerId], references: [id])
  product      Product?         @relation(fields: [productId], references: [id])
  messages     Message[]
  runs         AgentRun[]
  proposals    ActionProposal[]

  @@index([organizationId])
  @@index([ownerId])
  @@index([productId])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  role           MessageRole
  content        String
  /// 产生这条消息的运行
  runId          String?
  /// 引用卡：[{ kind: "knowledge"|"evidence"|"product", ref, title, path, hash }]
  citations      Json?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  WAITING_CONFIRMATION
  SUCCEEDED
  FAILED
  CANCELLED
}

model AgentRun {
  id             String         @id @default(uuid())
  organizationId String
  conversationId String?
  userId         String
  /// 长期数字员工身份；为空表示历史/未归属运行
  agentId        String?
  /// 本次运行所执行的数字员工任务；为空表示直接顾问会话等历史路径
  agentTaskId    String?
  /// 触发来源用于审计/回放，不承担授权含义
  triggerType    AgentTriggerType?
  triggerRef     String?
  goal           String
  /// 上下文快照：知识引用、产品版本、权限范围、检索时间（蓝图 §6）
  contextSnapshot Json?
  status         AgentRunStatus @default(QUEUED)
  provider       String?
  modelId        String?
  promptTemplateVersion String?
  /// TEST_STUB 表示未接真实模型，仅验证交互流程
  runMode        RunMode        @default(TEST_STUB)
  toolWhitelist  Json?
  attempt        Int            @default(1)
  /// worker 租约 / 心跳（蓝图 §6：崩溃恢复）
  leaseOwner     String?
  heartbeatAt    DateTime?
  cancelRequestedAt DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  durationMs     Int?
  /// token / 费用；未知即 "unknown"，不编造
  usageJson      Json?
  costStatus     String         @default("unknown")
  errorReason    String?
  /// 一次运行的可读交付摘要。委派子任务 SUCCEEDED 时必须非空，用于可靠返回父 Agent。
  outputSummary   String?
  outputMessageId String?
  /// 与既有 RunReceipt 关联而非竞争（蓝图 §7）
  receiptId      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation?    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation("AgentRunUser", fields: [userId], references: [id])
  agent        Agent?           @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agentTask    AgentTask?       @relation(fields: [agentTaskId], references: [id], onDelete: SetNull)
  toolCalls    ToolCall[]
  proposals    ActionProposal[]
  delegations AgentDelegation[] @relation("DelegationSourceRun")
  modelRuns    ModelRun[]

  @@index([organizationId])
  @@index([conversationId])
  @@index([agentId])
  @@index([agentTaskId])
  @@index([status])
}

enum ModelRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model ModelRun {
  id             String         @id @default(uuid())
  organizationId String
  agentRunId     String?
  taskClass      String
  policyKey      String
  policyVersion  String
  profileKey     String?
  provider       String?
  modelId        String?
  status         ModelRunStatus @default(RUNNING)
  attempts       Json?
  routingSkips   Json?
  usageJson      Json?
  requestMeta    Json?
  errorReason    String?
  startedAt      DateTime       @default(now())
  finishedAt     DateTime?
  durationMs     Int?
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentRun     AgentRun?     @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([agentRunId])
  @@index([policyKey, policyVersion])
  @@index([profileKey])
  @@index([status])
}

model ToolCall {
  id          String    @id @default(uuid())
  runId       String
  toolKey     String
  inputJson   Json?
  resultJson  Json?
  status      String    @default("RUNNING")
  errorReason String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  durationMs  Int?

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

enum ActionProposalStatus {
  DRAFT
  PENDING_CONFIRMATION
  APPLIED
  REJECTED
  SUPERSEDED
  EXPIRED
}

model ActionProposal {
  id             String               @id @default(uuid())
  organizationId String
  runId          String?
  conversationId String?
  productId      String?
  projectId      String?
  /// CREATE_WORK_ITEM / CREATE_REVISION / UPDATE_FIELD / ...
  actionType     String
  payloadJson    Json
  status         ActionProposalStatus @default(DRAFT)
  proposedById   String
  decidedById    String?
  decidedAt      DateTime?
  decisionReason String?
  appliedObjectType String?
  appliedObjectId   String?
  /// 幂等：重复点击或重试不得重复写入（蓝图 §5.3）
  idempotencyKey String?              @unique
  /// 旧版本提议在产品已改变时重新校验（蓝图 §5.3）
  baseVersionHash String?
  expectedRevision Int?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run          AgentRun?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  product      Product?      @relation(fields: [productId], references: [id])
  proposedBy   User          @relation("ActionProposalProposer", fields: [proposedById], references: [id])
  decidedBy    User?         @relation("ActionProposalDecider", fields: [decidedById], references: [id])

  @@index([organizationId])
  @@index([conversationId])
  @@index([productId])
  @@index([status])
}

// =============================================================
// U.5 Autonomous Workforce Kernel
//     Agent = 长期身份；Skill = 可复用 SOP；Squad = 协作路由；
//     AgentTask = 一次接活；AgentRun = 一次实际执行；Delegation = 委派证据。
//     本层不直接绕过 Governance Kernel：任何产品/项目业务写入仍走既有授权、
//     Proposal / Changeset / Audit / Receipt 约束。
// =============================================================

enum AgentLifecycleStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AgentAccessMode {
  OWNER_ONLY
  ORGANIZATION
}

enum SkillLifecycleStatus {
  ACTIVE
  ARCHIVED
}

enum SquadLifecycleStatus {
  ACTIVE
  ARCHIVED
}

enum SquadMemberType {
  AGENT
  HUMAN
}

enum AgentTaskStatus {
  QUEUED
  RUNNING
  BLOCKED
  WAITING_HUMAN
  SUBMITTED
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AgentTriggerType {
  MANUAL
  WORK_ITEM
  DELEGATION
  SYSTEM
  AUTOPILOT
  EVENT
  API
}

enum DelegationStatus {
  CREATED
  ACCEPTED
  COMPLETED
  FAILED
  CANCELLED
}

model Agent {
  id                 String               @id @default(uuid())
  organizationId     String
  code               String
  name               String
  description        String?
  roleKey            String
  instructions       String               @default("")
  /// 默认模型策略引用；实际 provider/modelId 记录在 AgentRun/ModelRun，而不是绑定在长期 Agent 身份上。
  modelPolicyKey     String?
  maxConcurrentTasks Int                  @default(2)
  accessMode         AgentAccessMode      @default(OWNER_ONLY)
  ownerId            String?
  isSystem           Boolean              @default(false)
  status             AgentLifecycleStatus @default(ACTIVE)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner             User?              @relation("WorkforceAgentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  skillBindings     AgentSkill[]
  ledSquads         Squad[]            @relation("WorkforceSquadLeader")
  squadMemberships  SquadMember[]
  tasks             AgentTask[]
  runs              AgentRun[]
  delegationsFrom   AgentDelegation[]  @relation("DelegationFromAgent")
  delegationsTo     AgentDelegation[]  @relation("DelegationToAgent")
  modelPolicyBindings AgentModelPolicyBinding[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([ownerId])
}

// =============================================================
// U.51 Model Control Center
//     Organization-scoped model profiles and task-class policies.
//     Credentials are intentionally NOT stored here.
// =============================================================

model ModelProfileConfig {
  id               String   @id @default(uuid())
  organizationId   String
  key              String
  displayName      String
  description      String?
  provider         String
  modelId          String
  capabilities     Json
  locality         String
  health           String   @default("HEALTHY")
  enabled          Boolean  @default(false)
  qualityTier      String
  latencyTier      String
  costTier         String
  contextWindow    Int?
  dataPolicyNote   String?
  isPreset         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId, enabled])
  @@index([organizationId, provider])
}

model ModelPolicyConfig {
  id                    String   @id @default(uuid())
  organizationId        String
  key                   String
  name                  String
  description           String?
  version               String
  taskClass             String
  candidates            Json
  requiredCapabilities  Json
  cloudAllowed          Boolean  @default(true)
  maxContextRequirement Int?
  failurePolicy         Json?
  isPreset              Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId, taskClass])
}

model AgentModelPolicyBinding {
  id             String   @id @default(uuid())
  organizationId String
  agentId        String
  taskClass      String
  policyKey      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, taskClass])
  @@index([organizationId, policyKey])
  @@index([organizationId, taskClass])
}

model Skill {
  id             String               @id @default(uuid())
  organizationId String
  key            String
  name           String
  description    String?
  instructions   String
  version        Int                  @default(1)
  references     Json?
  allowedTools   Json?
  outputSchema   Json?
  status         SkillLifecycleStatus @default(ACTIVE)
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy     User?        @relation("WorkforceSkillCreator", fields: [createdById], references: [id], onDelete: SetNull)
  agentBindings AgentSkill[]

  @@unique([organizationId, key])
  @@index([organizationId, status])
}

model AgentSkill {
  id           String   @id @default(uuid())
  agentId      String
  skillId      String
  enabled      Boolean  @default(true)
  assignedById String?
  assignedAt   DateTime @default(now())

  agent      Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill      Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("WorkforceSkillAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([agentId, skillId])
  @@index([skillId])
}

model Squad {
  id             String               @id @default(uuid())
  organizationId String
  code           String
  name           String
  description    String?
  instructions   String               @default("")
  leaderAgentId  String
  createdById    String?
  status         SquadLifecycleStatus @default(ACTIVE)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leader       Agent        @relation("WorkforceSquadLeader", fields: [leaderAgentId], references: [id])
  createdBy    User?        @relation("WorkforceSquadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members      SquadMember[]
  tasks        AgentTask[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([leaderAgentId])
}

model SquadMember {
  id              String          @id @default(uuid())
  squadId         String
  memberType      SquadMemberType
  agentId         String?
  userId          String?
  roleDescription String?
  createdAt       DateTime        @default(now())

  squad Squad @relation(fields: [squadId], references: [id], onDelete: Cascade)
  agent Agent? @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user  User?  @relation("WorkforceSquadHumanMember", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([squadId, agentId])
  @@unique([squadId, userId])
  @@index([agentId])
  @@index([userId])
}

model AgentTask {
  id              String          @id @default(uuid())
  organizationId  String
  agentId         String
  workItemId      String?
  squadId         String?
  parentTaskId    String?
  /// 触发本任务的主要决策证据；为空表示人工/旧路径/非 Decision Intelligence 触发。
  triggerDecisionRunId String?
  goal            String
  contextSnapshot Json?
  status          AgentTaskStatus @default(QUEUED)
  priority        Int             @default(50)
  triggerType     AgentTriggerType @default(MANUAL)
  triggerRef      String?
  blockedReason   String?
  attempt         Int             @default(1)
  maxAttempts     Int             @default(3)
  createdByUserId String?
  availableAt     DateTime        @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent        @relation(fields: [agentId], references: [id])
  workItem     WorkItem?    @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  squad        Squad?       @relation(fields: [squadId], references: [id], onDelete: SetNull)
  parentTask   AgentTask?   @relation("WorkforceAgentTaskParent", fields: [parentTaskId], references: [id], onDelete: SetNull)
  childTasks   AgentTask[]  @relation("WorkforceAgentTaskParent")
  triggerDecisionRun DecisionRun? @relation("DecisionRunTriggeredTasks", fields: [triggerDecisionRunId], references: [id], onDelete: SetNull)
  autopilotReceipt AutopilotEventReceipt?
  createdBy    User?        @relation("WorkforceAgentTaskCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  runs         AgentRun[]
  parentDelegations AgentDelegation[] @relation("DelegationParentTask")
  childDelegation   AgentDelegation?  @relation("DelegationChildTask")

  @@index([organizationId, status])
  @@index([agentId, status])
  @@index([workItemId])
  @@index([squadId])
  @@index([parentTaskId])
  @@index([triggerDecisionRunId])
  @@index([availableAt])
}

model AgentDelegation {
  id              String           @id @default(uuid())
  organizationId  String
  fromAgentId     String
  toAgentId       String
  parentTaskId    String?
  childTaskId     String           @unique
  sourceRunId     String?
  reason          String
  status          DelegationStatus @default(CREATED)
  createdByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromAgent    Agent        @relation("DelegationFromAgent", fields: [fromAgentId], references: [id])
  toAgent      Agent        @relation("DelegationToAgent", fields: [toAgentId], references: [id])
  parentTask   AgentTask?   @relation("DelegationParentTask", fields: [parentTaskId], references: [id], onDelete: SetNull)
  childTask    AgentTask    @relation("DelegationChildTask", fields: [childTaskId], references: [id], onDelete: Cascade)
  sourceRun    AgentRun?    @relation("DelegationSourceRun", fields: [sourceRunId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("WorkforceDelegationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([fromAgentId])
  @@index([toAgentId])
  @@index([parentTaskId])
  @@index([sourceRunId])
}

// =============================================================
// U.55 Decision Intelligence Provenance
// =============================================================

enum DecisionRunEngineKind {
  RULES
  MODEL
}

enum DecisionRunRiskClass {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DecisionRunPolicyAction {
  AUTO
  ESCALATE_AGENT
  ESCALATE_HUMAN
  BLOCK
}

model DecisionRun {
  id                 String                  @id @default(uuid())
  organizationId     String
  decisionKey        String
  specVersion        String
  outputType         String
  riskClass          DecisionRunRiskClass
  engine             DecisionRunEngineKind
  engineVersion      String

  /// 完整输入快照用于回放；hash 用于幂等、对比和审计。
  inputSnapshot      Json
  inputHash          String
  criteriaSnapshot   Json?
  criteriaHash       String?
  contextRefs        Json
  language           String?

  /// value 用对象包装，避免 JSON 顶层 primitive / null 的 ORM 差异。
  resultJson         Json
  confidence         Float?
  distribution       Json?
  reasonCodes        Json
  latencyMs          Int
  calibrated         Boolean                 @default(false)
  calibrationProfile String?
  benchmarkProfile   String?

  policyAction       DecisionRunPolicyAction
  policyReasons      Json
  createdById        String?
  createdAt          DateTime                 @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("DecisionRunCreator", fields: [createdById], references: [id], onDelete: SetNull)
  triggeredTasks AgentTask[] @relation("DecisionRunTriggeredTasks")
  autopilotReceipts AutopilotEventReceipt[]

  @@index([organizationId, decisionKey, createdAt])
  @@index([organizationId, policyAction])
  @@index([decisionKey, specVersion])
  @@index([engine, engineVersion])
  @@index([inputHash])
}

// =============================================================
// U.56 Autopilot / Event Wakeup
// =============================================================

enum AutopilotStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AutopilotActionKind {
  WAKE_PM
  WAKE_RED_TEAM
  WAKE_ROUTED_AGENT
}

enum AutopilotEventStatus {
  PENDING
  PROCESSING
  TRIGGERED
  SUPPRESSED
  WAITING_HUMAN
  FAILED
}

model Autopilot {
  id                  String          @id @default(uuid())
  organizationId      String
  key                 String
  name                String
  description         String?
  decisionKey         String
  decisionSpecVersion String
  actionKind          AutopilotActionKind
  status              AutopilotStatus @default(ACTIVE)
  cooldownSeconds     Int             @default(300)
  failureThreshold    Int             @default(3)
  consecutiveFailures Int             @default(0)
  pausedUntil         DateTime?
  lastError           String?
  createdById         String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?                   @relation("AutopilotCreator", fields: [createdById], references: [id], onDelete: SetNull)
  receipts     AutopilotEventReceipt[]

  @@unique([organizationId, key])
  @@index([organizationId, status])
  @@index([pausedUntil])
}

model AutopilotEventReceipt {
  id                String               @id @default(uuid())
  organizationId    String
  autopilotId       String
  eventKey          String
  eventType         String
  sourceType        String?
  sourceId          String?
  payloadHash       String
  payloadJson       Json
  contextRefs       Json
  taskGoal          String
  status            AutopilotEventStatus @default(PENDING)
  attempt           Int                  @default(0)
  maxAttempts       Int                  @default(3)
  decisionRunId     String?
  agentTaskId       String?              @unique
  suppressionReason String?
  errorReason       String?
  /// Worker lease enables crash recovery without double-processing a live receipt.
  leaseOwner        String?
  leaseExpiresAt    DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  autopilot    Autopilot    @relation(fields: [autopilotId], references: [id], onDelete: Cascade)
  decisionRun  DecisionRun? @relation(fields: [decisionRunId], references: [id], onDelete: SetNull)
  agentTask    AgentTask?   @relation(fields: [agentTaskId], references: [id], onDelete: SetNull)
  businessEvent BusinessEvent?

  @@unique([autopilotId, eventKey])
  @@index([organizationId, status])
  @@index([autopilotId, status])
  @@index([decisionRunId])
  @@index([sourceType, sourceId])
  @@index([leaseExpiresAt])
  @@index([createdAt])
}

// =============================================================
// U.57 Transactional Business Event Outbox
// =============================================================

enum BusinessEventStatus {
  PENDING
  PROCESSING
  DISPATCHED
  FAILED
}

model BusinessEvent {
  id                 String              @id @default(uuid())
  organizationId     String
  eventKey           String
  eventType          String
  aggregateType      String
  aggregateId        String
  payloadJson        Json
  payloadHash        String
  contextRefs        Json
  status             BusinessEventStatus @default(PENDING)
  attempt            Int                 @default(0)
  maxAttempts        Int                 @default(5)
  leaseOwner         String?
  leaseExpiresAt     DateTime?
  lastError          String?
  autopilotReceiptId String?             @unique
  createdById        String?
  dispatchedAt       DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy        User?                  @relation("BusinessEventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  autopilotReceipt AutopilotEventReceipt? @relation(fields: [autopilotReceiptId], references: [id], onDelete: SetNull)

  @@unique([organizationId, eventKey])
  @@index([organizationId, status])
  @@index([eventType, createdAt])
  @@index([aggregateType, aggregateId])
  @@index([leaseExpiresAt])
  @@index([createdAt])
}

// =============================================================
// U.6 Evaluation Harness & Experience Loop
// =============================================================

enum EvaluationSuiteStatus {
  ACTIVE
  ARCHIVED
}

enum EvaluationRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum EvaluationEvaluatorKind {
  CODE
  LLM_JUDGE
  HUMAN
  OUTCOME
}

enum FrozenPredictionVerdict {
  BLOCKED
  NEEDS_EVIDENCE
  DEPRIORITIZE
  VALIDATE
  PRIORITIZE_FOR_VALIDATION
}

enum ProductValidationOutcomeStatus {
  SUCCESS
  FAILURE
  INCONCLUSIVE
  NOT_RUN
}

enum BacktestAlignmentStatus {
  ALIGNED_SUCCESS
  ALIGNED_FAILURE
  FALSE_POSITIVE
  FALSE_NEGATIVE
  ABSTAINED
  INCONCLUSIVE
}

enum ExperienceLessonStatus {
  CANDIDATE
  APPROVED
  REJECTED
  SUPERSEDED
}

model EvaluationSuite {
  id             String                @id @default(uuid())
  organizationId String
  key            String
  name           String
  description    String?
  version        Int                   @default(1)
  status         EvaluationSuiteStatus @default(ACTIVE)
  createdById    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?                  @relation("EvaluationSuiteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  cases        EvaluationCase[]
  runs         EvaluationRun[]

  @@unique([organizationId, key, version])
  @@index([organizationId, status])
}

model EvaluationCase {
  id           String   @id @default(uuid())
  suiteId      String
  key          String
  title        String
  inputJson    Json
  expectedJson Json
  tags         Json?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  suite   EvaluationSuite       @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  results EvaluationCaseResult[]

  @@unique([suiteId, key])
  @@index([suiteId, active])
}

model EvaluationRun {
  id              String              @id @default(uuid())
  organizationId  String
  suiteId         String?
  triggerType     String              @default("MANUAL")
  status          EvaluationRunStatus @default(RUNNING)
  subjectType     String?
  subjectId       String?
  modelProfileId  String?
  modelPolicyKey  String?
  promptVersion   String?
  ruleVersion     String?
  metricsJson     Json?
  errorReason     String?
  startedById     String?
  startedAt       DateTime            @default(now())
  finishedAt      DateTime?
  createdAt       DateTime            @default(now())

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  suite        EvaluationSuite?       @relation(fields: [suiteId], references: [id], onDelete: SetNull)
  startedBy    User?                  @relation("EvaluationRunStarter", fields: [startedById], references: [id], onDelete: SetNull)
  results      EvaluationCaseResult[]

  @@index([organizationId, status])
  @@index([suiteId])
  @@index([subjectType, subjectId])
  @@index([modelProfileId])
  @@index([modelPolicyKey])
}

model EvaluationCaseResult {
  id               String                  @id @default(uuid())
  runId            String
  caseId           String?
  caseKey          String
  title            String
  evaluatorKind    EvaluationEvaluatorKind @default(CODE)
  passed           Boolean
  criticalFailures Int                     @default(0)
  outputJson       Json?
  checksJson       Json
  scoreJson        Json?
  createdAt        DateTime                @default(now())

  run  EvaluationRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  case EvaluationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([caseId])
  @@index([passed])
}

model FrozenPrediction {
  id                       String                   @id @default(uuid())
  organizationId           String
  productId                String
  productVersionId         String
  productVersionFingerprint String
  channelRouteId           String?
  channelRouteFingerprint  String?
  segmentKey               String                   @default("global")
  assessmentRuleVersion    String
  verdict                  FrozenPredictionVerdict
  diagnosticIndex          Float?
  coverageRatio            Float
  verifiedCoverageRatio    Float
  dimensionSnapshot        Json
  gateSnapshot             Json
  evidenceFingerprint      String?
  modelPolicyKey           String?
  modelProfileId           String?
  promptVersion            String?
  createdById              String
  evaluatedAt              DateTime                 @default(now())
  createdAt                DateTime                 @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVersion ProductVersion @relation(fields: [productVersionId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("FrozenPredictionCreator", fields: [createdById], references: [id])
  outcomes     ProductOutcome[]

  @@index([organizationId, productId])
  @@index([productVersionId])
  @@index([segmentKey])
  @@index([verdict])
  @@index([evaluatedAt])
}

model ProductOutcome {
  id                           String                         @id @default(uuid())
  organizationId               String
  frozenPredictionId           String
  observationKey               String
  outcome                      ProductValidationOutcomeStatus
  evidenceRefs                 Json
  verifiedById                 String
  verifiedAt                   DateTime
  channelAccepted              Boolean?
  launched                     Boolean?
  actualContributionMarginRate Float?
  actualReturnRate             Float?
  repeatPurchaseRate           Float?
  observationDays              Int?
  notes                        Json?
  backtestAlignment            BacktestAlignmentStatus
  backtestComparable           Boolean                        @default(true)
  backtestReason               String
  createdAt                    DateTime                       @default(now())

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  frozenPrediction FrozenPrediction @relation(fields: [frozenPredictionId], references: [id], onDelete: Cascade)
  verifiedBy       User             @relation("ProductOutcomeVerifier", fields: [verifiedById], references: [id])

  @@unique([frozenPredictionId, observationKey])
  @@index([organizationId, outcome])
  @@index([observationKey])
  @@index([backtestAlignment])
}

model ExperienceLesson {
  id                 String                 @id @default(uuid())
  organizationId     String
  key                String
  version            Int                    @default(1)
  segmentKey         String
  targetType         String?
  targetKey          String?
  statement          String
  supportCount       Int
  contradictionCount Int
  sampleSize         Int
  evidenceRefs       Json
  status             ExperienceLessonStatus @default(CANDIDATE)
  readyForReview     Boolean                @default(false)
  limitations        Json
  proposedChange     Json?
  reviewedById       String?
  reviewedAt         DateTime?
  decisionReason     String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("ExperienceLessonReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, key, version])
  @@index([organizationId, status])
  @@index([segmentKey, targetType, targetKey])
  @@index([readyForReview])
}

// =============================================================
// V. 公司知识：来源、文档、切片、同步批次、已确认事实（蓝图 §5.2）
//    数据库是任务/状态/版本/审批的事实来源；Obsidian 保存解释性文档。
//    聊天记录不自动变成公司事实。
// =============================================================

enum KnowledgeSourceKind {
  OBSIDIAN_VAULT
  LOCAL_DIR
}

model KnowledgeSource {
  id             String              @id @default(uuid())
  organizationId String
  kind           KnowledgeSourceKind @default(OBSIDIAN_VAULT)
  name           String
  /// 指定 Vault / 目录的绝对路径（首版只读导入，蓝图 §5.2）
  rootPath       String
  enabled        Boolean             @default(true)
  includeGlobs   Json?
  excludeGlobs   Json?
  /// 默认只读导入
  readOnly       Boolean             @default(true)
  lastSyncAt     DateTime?
  createdById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?             @relation("KnowledgeSourceCreator", fields: [createdById], references: [id])
  documents    KnowledgeDocument[]
  syncRuns     KnowledgeSyncRun[]

  @@index([organizationId])
}

model KnowledgeDocument {
  id             String    @id @default(uuid())
  sourceId       String
  organizationId String
  relativePath   String
  title          String
  frontmatter    Json?
  /// 内容哈希：判断是否需要重建切片
  contentHash    String
  byteSize       Int       @default(0)
  wordCount      Int?
  /// 来源更新时间（frontmatter 或文件 mtime）
  sourceUpdatedAt DateTime?
  /// 删除文档从新检索中移除（历史引用保留最小授权快照）
  deletedAt      DateTime?
  indexedAt      DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source       KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  chunks       KnowledgeChunk[]

  @@unique([sourceId, relativePath])
  @@index([organizationId])
  @@index([sourceId])
}

model KnowledgeChunk {
  id             String  @id @default(uuid())
  documentId     String
  organizationId String
  chunkIndex     Int
  /// 标题层级路径：品牌手册 > 渠道政策 > 私域
  headingPath    String?
  content        String
  tokens         Int?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([organizationId])
}

enum KnowledgeSyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model KnowledgeSyncRun {
  id             String              @id @default(uuid())
  sourceId       String
  organizationId String
  status         KnowledgeSyncStatus @default(RUNNING)
  scanned        Int                 @default(0)
  created        Int                 @default(0)
  updated        Int                 @default(0)
  deleted        Int                 @default(0)
  failed         Int                 @default(0)
  /// 失败文件与原因：[{ path, reason }]
  failures       Json?
  errorReason    String?
  startedById    String?
  startedAt      DateTime            @default(now())
  finishedAt     DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source       KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  startedBy    User?           @relation("KnowledgeSyncStarter", fields: [startedById], references: [id])

  @@index([organizationId])
  @@index([sourceId])
}

enum CompanyFactStatus {
  PENDING
  CONFIRMED
  SUPERSEDED
}

/// 已确认的公司事实：业务状态优先读数据库，公司政策取已确认且有效的版本，
/// 不能只依赖「最后修改时间」（蓝图 §5.2）。
model CompanyFact {
  id             String            @id @default(uuid())
  organizationId String
  key            String
  label          String
  value          String
  category       String            @default("general")
  status         CompanyFactStatus @default(PENDING)
  /// 来源文档与路径：资料冲突并列展示并要求确认，不自动合并
  sourceDocId    String?
  sourcePath     String?
  confirmedById  String?
  confirmedAt    DateTime?
  validFrom      DateTime?
  validUntil     DateTime?
  supersededById String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  confirmedBy  User?        @relation("CompanyFactConfirmer", fields: [confirmedById], references: [id])

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([status])
}

// =============================================================
// W. 上市计划与里程碑（蓝图 §4.5、§7）
//    审批通过只表示获准，不自动把产品标为已上市；实际上市由动作/证据确认。
//    执行动作复用 WorkItem，不建第二套任务系统。
// =============================================================

enum LaunchPlanStatus {
  DRAFT
  ACTIVE
  BLOCKED
  COMPLETED
  CANCELLED
}

model LaunchPlan {
  id             String            @id @default(uuid())
  organizationId String
  productId      String
  projectId      String?
  title          String
  targetDate     DateTime?
  ownerId        String?
  status         LaunchPlanStatus  @default(DRAFT)
  /// 上市计划治理修订号：基本信息/里程碑任一实质修改必须递增，用于 G3 CAS。
  governanceRevision Int @default(1)
  /// 获准时间（审批通过 ≠ 已上市）
  approvedAt     DateTime?
  /// 实际上市时间（由实际上市动作/证据确认）
  actualLaunchedAt DateTime?
  /// 当前有效的正式 G3 授权。历史 DecisionPacket / Decision 保持 append-only；
  /// 若计划随后发生实质修改，仅清空当前有效指针，不删除历史批准。
  formalG3PacketId   String?   @unique
  formalG3ApprovedAt DateTime?
  notes          String?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  project      Project?          @relation(fields: [projectId], references: [id])
  owner        User?             @relation("LaunchPlanOwner", fields: [ownerId], references: [id])
  milestones   LaunchMilestone[]
  decisionPackets DecisionPacket[] @relation("LaunchDecisionPackets")
  formalG3Packet DecisionPacket?   @relation("LaunchFormalG3", fields: [formalG3PacketId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([productId])
  @@index([status])
}

enum LaunchMilestoneStatus {
  PENDING
  IN_PROGRESS
  DONE
  BLOCKED
}

model LaunchMilestone {
  id             String                @id @default(uuid())
  planId         String
  organizationId String
  title          String
  /// MATERIAL / CHANNEL / SUPPLY / COMPLIANCE / OTHER
  kind           String                @default("OTHER")
  seq            Int                   @default(0)
  dueDate        DateTime?
  ownerId        String?
  status         LaunchMilestoneStatus @default(PENDING)
  blockerReason  String?
  completedAt    DateTime?
  /// 复用既有 WorkItem（蓝图 §7：避免双任务系统）
  workItemId     String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         LaunchPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  owner        User?        @relation("LaunchMilestoneOwner", fields: [ownerId], references: [id])

  @@index([organizationId])
  @@index([planId])
  @@index([status])
}
