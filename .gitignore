# Node dependencies
node_modules/
/.pnp
.pnp.js

# Next.js build output
.next/
out/

# Production
build/
dist/

# Environment files
.env*.local
.env

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Database & local runtime files
.pgdata*
.tmp-pg/
*.log

# OS metadata
.DS_Store
*.pem

# 构建产物（.next-*/ 均为本地验收/调试构建目录，单目录可达 400M+，禁止入库）
# 统一用通配规则兜底，避免每换一个验收目录名就要补一条忽略
.next-*/
.next-verify/
.next-acc/
.next-fixed/
.next-local-test/
.next-kernel/
.next-fresh/
.next-v2/
.next-v3/
tsconfig.tsbuildinfo

# 本地运行期数据（上传目录 / 迁移前备份）
.uploads/
prisma/_backups/

# 交付产物（PDF/PNG 汇总，体积大且可重生成，由 outputs/ 单独管理）
/outputs/

# PM OS Kernel local SQLite
data/kernel/


# Laya judgment-runtime local artifacts
services/judgment-runtime/.venv/
services/judgment-runtime/__pycache__/

# 工作区内部笔记（Agent 记忆），禁止入库
.workbuddy/

# PM Worker 运行时单实例锁与心跳
.pm-worker/
.pm-worker-local-test/
tools/response-preview/kern-conversation.html

# 本机环境备份（含密钥），永不提交
.env.bak*

# 一次性探针 / 截图脚本不入库：放 outputs/scratch-scripts/，需要保留的归档到 scripts/archive/
/scripts/_*

# 排障期临时产物（探针脚本 / Next trace 转储 / 代码图谱工具库），禁止入库
*.tmp.js
/probe-*.js
/trace
/.codegraph/
